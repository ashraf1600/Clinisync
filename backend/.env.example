# Environment configuration
ENVIRONMENT=development
PROJECT_NAME="Appointment Booking System"
API_V1_STR="/api/v1"

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/appointment_db

# Redis Cache & Queue
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change_this_to_a_super_secret_key_in_production_32_chars_min
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Password reset emails (leave SMTP_HOST empty to log the reset link instead of emailing it)
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@clinisync.local
SMTP_USE_TLS=true
